{
  "name": "mindfagg — Mindmap Markdown",
  "short_name": "mindfagg",
  "description": "Mindmap, Kanban, Kalender und Markdown in einer offline-fähigen, lokal gespeicherten App.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0e14",
  "theme_color": "#0b0e14",
  "lang": "de",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}